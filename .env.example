# ====================================================================
# Основные настройки Telegram Бота
# ====================================================================
# Токен вашего бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администраторов через запятую (например: 123456789 или 123456789,987654321)
ADMIN_IDS=123456789

# ID канала для публикации отзывов (необязательно, например @my_channel_reviews или -1001234567890)
REVIEWS_CHANNEL_ID=

# Путь к файлу базы данных SQLite
DB_PATH=database/reviews.db


# ====================================================================
# Режим запуска: Polling или Webhook
# ====================================================================
# Режим: "polling" (для локальной разработки) или "webhook" (для боевого сервера с доменом и SSL)
BOT_MODE=polling

# Публичный HTTPS URL вашего сервера (требуется только при BOT_MODE=webhook)
WEBHOOK_URL=https://reviews.yourdomain.com

# URL-путь для приема обновлений от Telegram (по умолчанию /webhook)
WEBHOOK_PATH=/webhook

# Секретный токен для проверки подлинности запросов от Telegram (рекомендуется для безопасности)
WEBHOOK_SECRET_TOKEN=super_secret_webhook_token_12345

# Хост и порт для встроенного aiohttp веб-сервера
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080


# ====================================================================
# Защита от спама и флуда (Rate Limiting)
# ====================================================================
# Минимальный интервал между действиями одного пользователя в секундах (админы игнорируются)
RATE_LIMIT_SECONDS=0.7


# ====================================================================
# Мониторинг ошибок (Sentry / GlitchTip)
# ====================================================================
# DSN ссылка проекта Sentry / GlitchTip (оставьте пустым, если не используется)
# Ошибки будут автоматически отправляться в Sentry и в личные сообщения админам в Telegram
SENTRY_DSN=
